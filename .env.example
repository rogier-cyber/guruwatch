# Kopieer naar .env voor lokaal draaien. Zet deze waarden in Render bij Environment.
DATABASE_URL=postgresql://user:password@host/guruwatch?sslmode=require
FMP_API_KEY=
EODHD_API_KEY=
RESEND_API_KEY=
MAIL_FROM=Guruwatch <login@guruwatch.nl>
# Willekeurige lange string, bv. uitvoer van: openssl rand -hex 32
SESSION_SECRET=
# Optioneel: komma-gescheiden lijst e-mailadressen die mogen inloggen. Leeg = iedereen.
ALLOWED_EMAILS=
# Optioneel: zet op false om de achtergrond-import uit te zetten.
INGEST_ENABLED=true
