<%- include('partials/head') %>
<section class="hero hero-sm">
  <div class="hero-in">
    <div>
      <h1>Insider<b> trades</b></h1>
      <p>Bestuurders en grootaandeelhouders moeten elke aankoop en verkoop van hun eigen aandelen binnen twee werkdagen melden bij de SEC. Verkopen kan om veel redenen, kopen doe je maar om één: je verwacht dat de koers stijgt.</p>
    </div>
    <div class="gk-hero-kpis">
      <div><strong class="kp-pos"><%= fmt.money(kpi.buy) %></strong><span>gekocht, 30 dagen</span></div>
      <div><strong class="kp-neg"><%= fmt.money(kpi.sell) %></strong><span>verkocht, 30 dagen</span></div>
      <div><strong><%= kpi.clusters %></strong><span>aandelen met 3+ kopers</span></div>
    </div>
  </div>
</section>
<% if (buyMap.length) { var maxIns = Math.max.apply(null, buyMap.map(function (b) { return b.insiders; })); %>
<div class="grid-side ins-top">
  <section class="card">
    <div class="card-h"><h2>Waar kopen insiders?</h2><span class="small muted">aankopen laatste 30 dagen · donkerder = meer verschillende kopers</span></div>
    <%- charts.treemap(buyMap.map(function (b) { var t = maxIns > 1 ? (b.insiders - 1) / (maxIns - 1) : 0; return { label: b.symbol, sub: fmt.money(b.value) + ' · ' + b.insiders + (b.insiders === 1 ? ' koper' : ' kopers'), value: Math.sqrt(b.value), fill: 'rgb(' + Math.round(110 - 96 * t) + ',' + Math.round(196 - 82 * t) + ',' + Math.round(160 - 70 * t) + ')', href: '/aandeel/' + encodeURIComponent(b.symbol) }; }), { width: 900, height: 330, label: 'Aankopen door insiders per aandeel' }).replace('class="treemap"', 'class="treemap only-desk"') %>
    <div class="only-phone"><%- charts.hbars(buyMap.slice(0, 10).map(function (b) { return { sym: b.symbol, name: b.name, value: b.value, display: fmt.money(b.value), href: '/aandeel/' + encodeURIComponent(b.symbol) }; })) %></div>
  </section>
  <% if (roleRows.length) { var pie = gc.pie(roleRows.map(function (r) { return { label: r.label, value: r.buy }; }), { size: 180, thickness: 26, center: fmt.money(kpi.buy), sub: 'gekocht' }); %>
  <aside class="card">
    <div class="card-h"><h2>Wie koopt er?</h2><span class="small muted">30 dagen</span></div>
    <div class="ins-pie"><%- pie.svg %></div>
    <ul class="gu-leg"><% pie.legend.forEach(function (l, i) { %><li><i style="background:<%= l.color %>"></i><span><%= l.label %></span><b><%= fmt.money(roleRows[i] ? roleRows[i].buy : 0) %></b></li><% }) %></ul>
  </aside>
  <% } %>
</div>
<% } %>
<section class="card">
  <div class="card-h"><h2>Kopen vs verkopen, laatste 60 dagen</h2><span class="chart-legend"><span><i class="sw-buy"></i>Gekocht</span><span><i class="sw-sell"></i>Verkocht</span></span></div>
  <%- charts.both.divergingBars(flows, { width: 1100, height: 170, fmt: fmt.money, posLabel: 'gekocht', negLabel: 'verkocht', sqrt: true }) %>
</section>
<div class="grid-side">
  <section class="card">
    <div class="filters">
      <a href="?type=buy<%= minValue ? '&min=' + minValue : '' %>" class="<%= type === 'buy' ? 'on' : '' %>">Aankopen</a>
      <a href="?type=sell<%= minValue ? '&min=' + minValue : '' %>" class="<%= type === 'sell' ? 'on' : '' %>">Verkopen</a>
      <a href="?type=all<%= minValue ? '&min=' + minValue : '' %>" class="<%= type === 'all' ? 'on' : '' %>">Alles</a>
      <span class="sep"></span>
      <a href="?type=<%= type %>" class="<%= !minValue ? 'on' : '' %>">Elk bedrag</a>
      <a href="?type=<%= type %>&min=100000" class="<%= minValue === 100000 ? 'on' : '' %>">&gt; $100k</a>
      <a href="?type=<%= type %>&min=1000000" class="<%= minValue === 1000000 ? 'on' : '' %>">&gt; $1 mln</a>
    </div>
    <%- include('partials/insiders', { rows: trades }) %>
  </section>
  <aside class="card">
    <h2>Meerdere insiders kopen</h2>
    <p class="small muted">Aandelen waar de afgelopen 30 dagen meerdere bestuurders of grootaandeelhouders eigen aandelen kochten. Als meerdere insiders tegelijk kopen, is dat historisch een sterker signaal dan één losse aankoop: zij kennen het bedrijf het best en zetten er samen eigen geld op in.</p>
    <% if (!clusters.length) { %><p class="empty">Nog geen data.</p><% } else { %>
    <%- charts.hbars(clusters.map(function (c) { return { sym: c.symbol, name: c.name, value: c.insiders, display: c.insiders + ' insiders · ' + fmt.money(c.value) + ' gekocht', href: '/aandeel/' + encodeURIComponent(c.symbol) }; })) %>
    <% } %>
  </aside>
</div>
<%- include('partials/foot') %>
