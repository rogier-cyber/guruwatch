<%- include('partials/head') %>
<section class="hero hero-sm">
  <div class="hero-in">
    <div>
      <h1 class="h-with-guru"><span class="h-guru" aria-hidden="true"><span class="gw-guru gw-guru-gold"></span></span>Insider <span class="h-mon">Guru's</span></h1>
      <p>Bestuurders en grootaandeelhouders moeten elke aankoop en verkoop van hun eigen aandelen binnen twee werkdagen melden bij de SEC. Verkopen kan om veel redenen, kopen doe je maar om één: je verwacht dat de koers stijgt.</p>
    </div>
    <div class="gk-hero-kpis">
      <div><strong class="kp-pos"><%= fmt.money(kpi.buy) %></strong><span>gekocht, 30 dagen</span></div>
      <div><strong class="kp-neg"><%= fmt.money(kpi.sell) %></strong><span>verkocht, 30 dagen</span></div>
      <div><strong><%= kpi.clusters %></strong><span>aandelen met 3+ kopers</span></div>
    </div>
  </div>
</section>
<% if (buyMap.length) { var maxIns = Math.max.apply(null, buyMap.map(function (b) { return b.insiders; })); %>
<div class="grid-side ins-top">
  <section class="card">
    <div class="card-h"><h2>Waar kopen insiders?</h2><span class="small muted">aankopen laatste 30 dagen · donkerder = meer verschillende kopers</span></div>
    <%- charts.treemap(buyMap.map(function (b, i) { var t = maxIns > 1 ? (b.insiders - 1) / (maxIns - 1) : 0; return { label: b.symbol, sub: fmt.money(b.value), sub2: b.insiders + (b.insiders === 1 ? ' koper' : ' kopers'), value: Math.sqrt(b.value), fill: 'rgb(' + Math.round(110 - 96 * t) + ',' + Math.round(196 - 82 * t) + ',' + Math.round(160 - 70 * t) + ')', href: '/aandeel/' + encodeURIComponent(b.symbol), tip: buyTiles[i].tip, logo: buyTiles[i].logo }; }), { width: 900, height: 430, label: 'Aankopen door insiders per aandeel' }).replace('class="treemap"', 'class="treemap only-desk"') %>
    <div class="only-phone"><%- charts.hbars(buyMap.slice(0, 10).map(function (b, i) { return { sym: b.symbol, name: b.name, value: b.value, display: fmt.money(b.value), href: '/aandeel/' + encodeURIComponent(b.symbol), tip: buyTiles[i].tip, logo: buyTiles[i].logo }; })) %></div>
  </section>
  <% if (roleRows.length) { var pie = gc.pie(roleRows.map(function (r) { return { label: r.label, value: r.buy }; }), { size: 180, thickness: 26, center: fmt.money(kpi.buy), sub: 'gekocht' }); %>
  <aside class="card">
    <div class="card-h"><h2>Wie koopt er?</h2><span class="small muted">30 dagen</span></div>
    <div class="ins-pie"><%- pie.svg %></div>
    <ul class="gu-leg"><% pie.legend.forEach(function (l, i) { %><li><i style="background:<%= l.color %>"></i><span><%= l.label %></span><b><%= fmt.money(roleRows[i] ? roleRows[i].buy : 0) %></b></li><% }) %></ul>
  </aside>
  <% } %>
</div>
<% } %>
<section class="card">
  <div class="card-h"><h2>Kopen vs verkopen, laatste 60 dagen</h2><span class="chart-legend"><span><i class="sw-buy"></i>Gekocht</span><span><i class="sw-sell"></i>Verkocht</span></span></div>
  <%- charts.both.divergingBars(flows, { width: 1100, height: 170, fmt: fmt.money, posLabel: 'gekocht', negLabel: 'verkocht', sqrt: true }) %>
</section>
<div class="grid-side">
  <section class="card">
    <% var zq = zoek ? '&zoek=' + encodeURIComponent(zoek) : ''; %>
    <div class="ins-bar">
      <div class="filters">
        <a href="?type=buy<%= minValue ? '&min=' + minValue : '' %><%= zq %>" class="<%= type === 'buy' ? 'on' : '' %>">Aankopen</a>
        <a href="?type=sell<%= minValue ? '&min=' + minValue : '' %><%= zq %>" class="<%= type === 'sell' ? 'on' : '' %>">Verkopen</a>
        <a href="?type=all<%= minValue ? '&min=' + minValue : '' %><%= zq %>" class="<%= type === 'all' ? 'on' : '' %>">Alles</a>
        <span class="sep"></span>
        <a href="?type=<%= type %><%= zq %>" class="<%= !minValue ? 'on' : '' %>">Elk bedrag</a>
        <a href="?type=<%= type %>&min=100000<%= zq %>" class="<%= minValue === 100000 ? 'on' : '' %>">&gt; $100k</a>
        <a href="?type=<%= type %>&min=1000000<%= zq %>" class="<%= minValue === 1000000 ? 'on' : '' %>">&gt; $1 mln</a>
      </div>
      <form class="ins-search" method="get" action="/insiders" role="search">
        <input type="hidden" name="type" value="<%= type %>"><% if (minValue) { %><input type="hidden" name="min" value="<%= minValue %>"><% } %>
        <div class="sx ins-sx"><input type="search" name="zoek" value="<%= zoek %>" placeholder="Bedrijf of ticker, bv. Apple" aria-label="Zoek insider trades van een aandeel" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="ins-sx-list" data-sx="insiders"><div class="sx-list" id="ins-sx-list" role="listbox" hidden></div></div>
        <button type="submit">Zoek</button>
      </form>
    </div>
    <% if (zoek) { %><p class="ins-found small">
      <% if (zoekSyms && zoekSyms.length) { %>Insider trades van de laatste 2 jaar voor <b><%= zoekSyms.slice(0, 6).join(', ') %><%= zoekSyms.length > 6 ? ' …' : '' %></b> (<%= trades.length %><%= trades.length >= 200 ? '+' : '' %>)<% } else { %>Geen aandeel met insider trades gevonden voor <b>“<%= zoek %>”</b>.<% } %>
      · <a href="/insiders">wis zoekopdracht</a><% if (zoekSyms && zoekSyms.length === 1) { %> · <a href="/aandeel/<%= encodeURIComponent(zoekSyms[0]) %>">naar de aandeelpagina</a><% } %></p><% } %>
    <%- include('partials/insiders', { rows: trades, max: 40, step: 40 }) %>
  </section>
  <aside class="card">
    <h2>Meerdere insiders kopen</h2>
    <p class="small muted">Aandelen waar de afgelopen 30 dagen meerdere bestuurders of grootaandeelhouders eigen aandelen kochten. Als meerdere insiders tegelijk kopen, is dat historisch een sterker signaal dan één losse aankoop: zij kennen het bedrijf het best en zetten er samen eigen geld op in.</p>
    <% if (!clusters.length) { %><p class="empty">Nog geen data.</p><% } else { %>
    <%- charts.hbars(clusters.map(function (c) { return { sym: c.symbol, name: c.name, value: c.insiders, display: c.insiders + (c.insiders === 1 ? ' insider · ' : ' insiders · ') + fmt.money(c.value) + ' gekocht', href: '/aandeel/' + encodeURIComponent(c.symbol) }; })) %>
    <% } %>
    <a class="more-btn more-link" href="/insiders/meerdere-kopers">Bekijk de hele lijst van 2 maanden <span aria-hidden="true">→</span></a>
  </aside>
</div>
<%- include('partials/foot') %>
