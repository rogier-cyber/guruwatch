<%- include('partials/head') %>
<section class="hero hero-sm">
  <div class="hero-in">
    <div>
      <h1>Analisten</h1>
      <% if (tab === 'radar') { %><p>De analistenradar: welke aandelen krijgen er analistenliefde bij, waar lopen koers en verwachting uit elkaar, en waar is iedereen het (te) eens?</p>
      <% } else { %><p>Elke analist afgerekend op zijn trackrecord: haalde het koersdoel het binnen 12 maanden, en versloeg het advies de S&amp;P 500?</p><% } %>
    </div>
    <% if (tab === 'radar' && radar.rtab === 'momentum') { var totals = radar.totals, herds = radar.herds; var rdN = totals.pos + totals.neg; var rdShare = rdN ? totals.pos / rdN : 0.5; %>
    <div class="rd-hero-kpis">
      <div class="rd-mood"><%- viz.moodGauge(rdShare, { width: 150, label: 'Aandeel aandelen met verbeterend sentiment' }) %><div><strong><%= Math.round(rdShare * 100) %>%</strong><span>van de aandelen krijgt er analistenliefde bij</span></div></div>
      <div class="gk-hero-kpis rd-k">
        <div><strong class="kp-pos"><%= fmt.num(totals.pos) %></strong><span>sentiment verbetert</span></div>
        <div><strong class="kp-neg"><%= fmt.num(totals.neg) %></strong><span>sentiment verslechtert</span></div>
        <div><strong><%= fmt.num(herds.length) %></strong><span>kuddes deze week</span></div>
      </div>
    </div>
    <% } %>
    <% if (locals.kpi && tab !== 'radar') { %>
    <div class="gk-hero-kpis">
      <div><strong><%= kpi.analysts.toLocaleString('nl-NL') %></strong><span>analisten met een score</span></div>
      <div><strong><%= kpi.medHit === null ? '–' : fmt.pct(kpi.medHit, false) %></strong><span>mediane trefkans</span></div>
      <div><strong><%= kpi.beat === null ? '–' : fmt.pct(kpi.beat, false) %></strong><span>verslaat de markt</span></div>
    </div>
    <% } %>
  </div>
</section>
<nav class="tabs">
  <a href="?tab=ranglijst" class="<%= tab === 'ranglijst' ? 'on' : '' %>">Ranglijst</a>
  <a href="?tab=koersdoelen" class="<%= tab === 'koersdoelen' ? 'on' : '' %>">Koersdoelen</a>
  <a href="?tab=ratings" class="<%= tab === 'ratings' ? 'on' : '' %>">Up-/downgrades</a>
  <a href="?tab=banken" class="<%= tab === 'banken' ? 'on' : '' %>">Banken</a>
  <a href="?tab=radar" class="<%= tab === 'radar' ? 'on' : '' %>">Radar</a>
</nav>
<% if (tab === 'radar') { %>
<%- include('partials/radar-body', Object.assign({}, radar, { tab: radar.rtab })) %>
<% } else { %>
<section class="card">
<% if (tab === 'ranglijst') { %>
  <% if (!scored) { %>
  <p class="alert info">De GuruScore wordt nog berekend: eerst wordt de koersdoel-historie en koershistorie opgehaald. Tot die tijd zie je hieronder een voorlopige ranglijst.</p>
  <% } %>
  <% if (!leaders.length) { %><p class="empty">Nog te weinig data voor een ranglijst.</p><% } else if (scored) { %>
  <div class="podium2">
    <% [1, 0, 2].forEach(function (k) { var a = leaders[k]; if (!a) return; %>
    <a class="pd pd-<%= k + 1 %>" href="/analist/<%= a.slug %>">
      <span class="pd-rank"><%= k + 1 %></span>
      <%- charts.scoreRing(a.score, k === 0 ? 92 : 74) %>
      <strong><%= fmt.person(a.name) %></strong>
      <span class="pd-firm"><%= a.firm %></span>
      <span class="pd-stats"><b class="<%= fmt.tone(a.avg_excess) %>"><%= fmt.pct(a.avg_excess) %></b> vs S&amp;P<i></i><b><%= fmt.pct(a.hit_rate, false) %></b> raak<i></i><b><%= a.calls %></b> adviezen</span>
    </a>
    <% }) %>
  </div>
  <% if (locals.mapPoints && mapPoints.length >= 5) { %>
  <div class="an-grid">
    <div class="an-map">
      <div class="card-h"><h2>Wie is vaak raak én verslaat de markt?</h2><span class="small muted">bolletje = analist · groter = meer adviezen</span></div>
      <div class="only-desk"><%- viz.analystMap(mapPoints, { width: 740, height: 380 }) %></div>
      <div class="only-phone"><%- viz.analystMap(mapPoints, { width: 380, height: 340 }) %></div>
      <div class="am-filter" data-am-filter>
        <div class="am-f-top"><b>Toon GuruScore</b><span class="am-f-val" data-am-val>Alle analisten</span><span class="small muted" data-am-n></span></div>
        <div class="am-f-row">
          <button type="button" class="am-f-all on" data-am-all>Alle</button>
          <div class="am-f-track">
            <input type="range" min="0" max="9" step="1" value="0" class="off" aria-label="Kies een GuruScore-bereik van 10 punten" data-am-range>
            <div class="am-f-ticks" aria-hidden="true"><% for (var t = 0; t < 100; t += 10) { %><span><%= t %>-<%= t + 10 %></span><% } %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="an-side">
      <div>
        <div class="card-h"><h2>Verdeling van GuruScores</h2></div>
        <%- viz.scoreHistogram(buckets) %>
      </div>
      <% if (firms.best.length) { %>
      <div>
        <div class="card-h"><h2>Beste banken</h2><a href="?tab=banken" class="small">Alle banken</a></div>
        <div class="fb-list">
        <% firms.best.forEach(function (f, i) { %>
          <a class="fb" href="/bank/<%= encodeURIComponent(f.firm) %>"><span class="fb-n"><%= i + 1 %></span><%- charts.scoreRing(f.score, 32) %><span class="fb-t"><b><%= f.firm %></b><em><%= fmt.pct(f.hit_rate, false) %> raak · <%= f.calls %> adviezen</em></span><span class="fb-x <%= fmt.tone(f.avg_excess) %>"><%= fmt.pct(f.avg_excess) %></span></a>
        <% }) %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>
  <div class="card-h mt"><h2>Ranglijst</h2><span class="small muted">De <strong>GuruScore</strong> (0–100) combineert trefkans, rendement boven de S&amp;P 500 en het aantal adviezen. <a href="/methode">Zo werkt het</a></span></div>
  <div class="tbl-wrap"><table class="tbl an-tbl">
    <thead><tr><th>#</th><th>Analist</th><th>Score</th><th class="only-desk-cell">Trefkans</th><th class="r">Vs. S&amp;P 500</th><th class="r only-desk-cell">Adviezen</th></tr></thead>
    <tbody>
    <% var maxEx = Math.max.apply(null, leaders.map(function (a) { return Math.abs(Number(a.avg_excess) || 0); }).concat([0.05])); %>
    <% leaders.forEach(function (a, i) { var ex = Number(a.avg_excess) || 0; %>
      <tr<%- i >= 25 ? ' hidden' : '' %>>
        <td class="muted an-rank"><%= i + 1 %></td>
        <td><%- ui.who(fmt.person(a.name), a.firm, '/analist/' + a.slug, fmt.person(a.name) + (a.firm ? ' · ' + a.firm : '') + '\nGuruScore ' + Math.round(a.score) + ' · nr. ' + (i + 1) + '\nTrefkans ' + fmt.pct(a.hit_rate, false) + ' (koersdoel gehaald binnen 12 maanden)\nGemiddeld ' + fmt.pct(ex) + ' ten opzichte van de S&P 500\n' + a.calls + ' beoordeelde adviezen') %></td>
        <td><%- charts.scoreRing(a.score, 36) %></td>
        <td class="only-desk-cell"><span class="an-bar"><i style="width:<%= Math.round((Number(a.hit_rate) || 0) * 100) %>%"></i></span><span class="an-bar-v"><%= fmt.pct(a.hit_rate, false) %></span></td>
        <td class="r"><span class="an-ex"><span class="an-ex-bar <%= ex >= 0 ? 'pos' : 'neg' %>" style="width:<%= Math.round(Math.abs(ex) / maxEx * 48) %>px"></span><b class="<%= fmt.tone(ex) %>"><%= fmt.pct(ex) %></b></span></td>
        <td class="r only-desk-cell"><%= a.calls %></td>
      </tr>
    <% }) %>
    </tbody></table></div>
  <% if (leaders.length > 25) { %><button class="more-btn" data-more="25">Meer analisten (nog <span data-more-n><%= leaders.length - 25 %></span>)</button><% } %>
  <% } else { %>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>#</th><th>Analist</th><th>Bank</th><th class="r">Beoordeeld</th><th class="r">Goede richting</th><th class="r">Doel gehaald</th><th class="r">Gem. rendement</th></tr></thead>
    <tbody>
    <% leaders.forEach(function (a, i) { %>
      <tr<%- i >= 25 ? ' hidden' : '' %>><td class="muted"><%= i + 1 %></td><td><a href="/analist/<%= a.slug %>" class="strong"><%= a.name %></a></td>
      <td><% if (a.firm) { %><a href="/bank/<%= encodeURIComponent(a.firm) %>"><%= a.firm %></a><% } %></td>
      <td class="r"><%= a.scored %></td><td class="r"><%= fmt.pct(a.success_rate, false) %></td><td class="r"><%= fmt.pct(a.hit_rate, false) %></td>
      <td class="r <%= fmt.tone(a.avg_return) %>"><%= fmt.pct(a.avg_return) %></td></tr>
    <% }) %>
    </tbody></table></div>
  <% if (leaders.length > 25) { %><button class="more-btn" data-more="25">Meer analisten (nog <span data-more-n><%= leaders.length - 25 %></span>)</button><% } %>
  <% } %>
<% } else if (tab === 'koersdoelen') { %>
  <%- include('partials/targets', { rows: targets }) %>
<% } else if (tab === 'ratings') { %>
  <div class="filters"><a href="?tab=ratings" class="<%= !action ? 'on' : '' %>">Alle</a><a href="?tab=ratings&actie=upgrade" class="<%= action === 'upgrade' ? 'on' : '' %>">Upgrades</a><a href="?tab=ratings&actie=downgrade" class="<%= action === 'downgrade' ? 'on' : '' %>">Downgrades</a></div>
  <%- include('partials/grades', { rows: grades }) %>
<% } else { %>
  <% if (firmScores.length) { %>
  <h2>Banken op GuruScore</h2>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>#</th><th>GuruScore</th><th>Bank</th><th class="r">Adviezen</th><th class="r">Trefkans</th><th class="r">Gem. rendement</th><th class="r">Vs. S&amp;P 500</th></tr></thead><tbody>
  <% firmScores.forEach(function (f, i) { %><tr><td class="muted"><%= i + 1 %></td><td><%- include('partials/score', { score: f.score }) %></td><td><a href="/bank/<%= encodeURIComponent(f.firm) %>" class="strong"><%= f.firm %></a></td><td class="r"><%= f.calls %></td><td class="r"><%= fmt.pct(f.hit_rate, false) %></td><td class="r <%= fmt.tone(f.avg_return) %>"><%= fmt.pct(f.avg_return) %></td><td class="r <%= fmt.tone(f.avg_excess) %>"><%= fmt.pct(f.avg_excess) %></td></tr><% }) %>
  </tbody></table></div>
  <h2 class="mt">Meest actief (90 dagen)</h2>
  <% } else { %>
  <p class="small muted">Meest actieve banken in de laatste 90 dagen.</p>
  <% } %>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Bank</th><th class="r">Ratings</th><th class="r">Upgrades</th><th class="r">Downgrades</th><th>Laatste</th></tr></thead><tbody>
  <% firms.forEach(function (f) { %><tr><td><a href="/bank/<%= encodeURIComponent(f.firm) %>" class="strong"><%= f.firm %></a></td><td class="r"><%= f.n %></td><td class="r pos"><%= f.upgrades %></td><td class="r neg"><%= f.downgrades %></td><td class="muted"><%= fmt.ago(f.last_at) %></td></tr><% }) %>
  </tbody></table></div>
<% } %>
</section>
<% } %>
<%- include('partials/foot') %>
