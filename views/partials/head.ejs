<!doctype html>
<html lang="nl"<% if (!locals.user) { %> data-anon<% } %>>
<head>
  <meta charset="utf-8">
  <script>
    // Openbare pagina's komen uit de edge-cache (zonder inlog). Ingelogd (cookie gw_in)? Dan vragen we
    // pagina's op met ?u=1: die slaat de cache over, zodat je je eigen volglijst en menu ziet.
    (function () { try {
      var d = document.documentElement, anon = d.hasAttribute('data-anon'), inC = /(?:^|; )gw_in=1/.test(document.cookie);
      if (!inC) return;
      var u = new URL(location.href);
      if (anon) {
        if (!u.searchParams.has('u')) { u.searchParams.set('u', '1'); location.replace(u.toString()); }
        else document.cookie = 'gw_in=; Max-Age=0; path=/';
        return;
      }
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a || a.target || a.origin !== location.origin || a.pathname.indexOf('/static/') === 0) return;
        var x = new URL(a.href);
        if (!x.searchParams.has('u')) { x.searchParams.set('u', '1'); a.href = x.toString(); }
      }, true);
      document.addEventListener('submit', function (e) {
        var f = e.target;
        if ((f.method || 'get').toLowerCase() !== 'get' || f.querySelector('input[name="u"]')) return;
        var i = document.createElement('input'); i.type = 'hidden'; i.name = 'u'; i.value = '1'; f.appendChild(i);
      }, true);
    } catch (e) {} })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %><%= locals.fullTitle ? "" : " · Guruwatch" %></title>
  <% if (locals.seo) { %>
  <meta name="description" content="<%= seo.description %>">
  <% if (seo.canonical) { %><link rel="canonical" href="<%= seo.canonical %>"><meta property="og:url" content="<%= seo.canonical %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Guruwatch">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <% if (seo.image) { %><meta property="og:image" content="<%= seo.image %>"><% } %>
  <meta name="twitter:card" content="summary">
  <% (seo.jsonld || []).forEach(function (j) { %><script type="application/ld+json"><%- JSON.stringify(j).replace(/</g, '\\u003c') %></script>
  <% }) %>
  <% } else { %><meta name="robots" content="noindex"><% } %>
  <meta name="theme-color" content="#14213d">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/static/style.css?v=68">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/static/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
</head>
<body>
<header class="top">
  <div class="wrap top-in">
    <a class="brand" href="/" aria-label="Guruwatch"><img src="/static/img/guru.png" alt=""><span class="wordmark">Guru<b>watch</b></span></a>
    <nav class="nav">
      <a href="/aandelen" class="<%= path === '/aandelen' || path.startsWith('/aandeel/') ? 'on' : '' %>">Aandelen</a>
      <a href="/analisten" class="<%= path.startsWith('/analist') || path.startsWith('/bank') ? 'on' : '' %>">Analisten</a>
      <a href="/gurus" class="<%= path.startsWith('/guru') ? 'on' : '' %>">Guru's</a>
      <a href="/insiders" class="<%= path.startsWith('/insider') ? 'on' : '' %>">Insiders</a>
      <a href="/kalender" class="<%= path === '/kalender' || path.indexOf('/cijfers/') > 0 ? 'on' : '' %>">Kalender</a>
      <a href="/community" class="<%= path.startsWith('/community') || path.startsWith('/lid/') ? 'on' : '' %>">Community</a>
      <a href="/blog" class="<%= path.startsWith('/blog') ? 'on' : '' %>">Blog</a>
      <a href="/mijn" class="<%= path.startsWith('/mijn') ? 'on' : '' %>">Mijn GuruWatch<% if (locals.unread) { %> <span class="badge"><%= unread > 99 ? '99+' : unread %></span><% } %></a>
    </nav>
    <form class="search" action="/zoek" method="get" role="search">
      <div class="sx">
        <input name="q" placeholder="Zoek aandeel, analist of guru" value="<%= path === '/zoek' ? (query.q || '') : '' %>" aria-label="Zoeken" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sx-list">
        <div class="sx-list" id="sx-list" role="listbox" hidden></div>
      </div>
    </form>
    <script src="/static/search.js?v=6" defer></script>
    <% if (user) { %>
    <form action="/logout" method="post" class="logout"><button class="link" title="<%= user.email %>">Uitloggen</button></form>
    <% } else { %>
    <div class="top-cta"><a class="btn btn-primary" href="/login?next=<%= encodeURIComponent(path) %>">Inloggen</a></div>
    <% } %>
  </div>
</header>
<main class="wrap">
