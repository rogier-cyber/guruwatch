<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Guruwatch</title>
  <meta name="theme-color" content="#14213d">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/static/style.css?v=2">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/static/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
</head>
<body>
<header class="top">
  <div class="wrap top-in">
    <a class="brand" href="/" aria-label="Guruwatch"><img src="/static/img/guru.png" alt=""><span class="wordmark">Guru<b>watch</b></span></a>
    <% if (user) { %>
    <nav class="nav">
      <a href="/analisten" class="<%= path.startsWith('/analist') || path.startsWith('/bank') ? 'on' : '' %>">Analisten</a>
      <a href="/radar" class="<%= path === '/radar' ? 'on' : '' %>">Radar</a>
      <a href="/insiders" class="<%= path.startsWith('/insider') ? 'on' : '' %>">Insiders</a>
      <a href="/fondsen" class="<%= path.startsWith('/fonds') ? 'on' : '' %>">Hedge funds</a>
      <a href="/mijn" class="<%= path.startsWith('/mijn') ? 'on' : '' %>">Mijn GuruWatch<% if (locals.unread) { %> <span class="badge"><%= unread > 99 ? '99+' : unread %></span><% } %></a>
    </nav>
    <form class="search" action="/zoek" method="get" role="search">
      <input name="q" placeholder="Zoek aandeel, analist of fonds" value="<%= path === '/zoek' ? (query.q || '') : '' %>" aria-label="Zoeken">
    </form>
    <form action="/logout" method="post" class="logout"><button class="link" title="<%= user.email %>">Uitloggen</button></form>
    <% } %>
  </div>
</header>
<main class="wrap">
