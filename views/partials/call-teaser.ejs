<%
var ct = callTeaser.cur, ca = ct.analysis, cc = callTeaser.cmp, ev = callTeaser.ev, nl = callTeaser.nl, pv = callTeaser.prev;
var toneNow = callCharts.score(ca.tone.mgmt.net), tonePrev = pv && pv.analysis && pv.analysis.tone ? callCharts.score(pv.analysis.tone.mgmt.net) : null;
var tot = function (a, k) { return tr.per10k((a.topics.mgmt[k] || 0) + (a.topics.analysts[k] || 0), a.words.total); };
var topics = tr.TOPICS.map(function (t) { return { key: t.key, label: t.label, v: tot(ca, t.key), p: pv && pv.analysis ? tot(pv.analysis, t.key) : null }; })
  .filter(function (t) { return t.v > 0; }).sort(function (a, b) { return b.v - a.v; }).slice(0, 5);
var tMax = Math.max.apply(null, topics.map(function (t) { return t.v; }).concat([1]));
var days = Math.round((Date.now() - new Date(ct.date).getTime()) / 864e5);
var intro = nl && nl.summary ? fmt.paras(nl.summary, 260)[0] : (callTeaser.story || []).slice(0, 2).join(' ');
var kps = nl && nl.keyPoints ? nl.keyPoints.slice(0, 3) : [];
var outl = nl && nl.outlook ? nl.outlook.slice(0, 2) : [];
var ex = callTeaser.ex;
var exTopic = ex && ex.topics && ex.topics.length ? tr.lc(tr.topicLabel(ex.topics[0])) : null;
%>
<section class="card call-teaser" id="earnings-call">
  <div class="card-h"><h2>Earnings call <%= name %> Q<%= ct.quarter %> <%= ct.year %><% if (days <= 30) { %> <span class="ct-new">Nieuw</span><% } %></h2><span class="small muted"><%= fmt.date(ct.date) %></span></div>
  <p class="sec-txt">Wat zei het management van <%= name %> tegen de analisten van Wall Street? Hieronder de kern<%= nl ? ', in het Nederlands' : '' %>. Het hele verslag met alle vragen en antwoorden staat op de call-pagina.</p>

  <% if (ev) { %>
  <div class="syn-res ct-res">
    <div><span>Winst per aandeel</span><b><%= fmt.price(ev.eps_actual) %></b><em class="small <%= fmt.tone(ev.surprise) %>"><%= ev.surprise == null ? 'prognose ' + fmt.price(ev.eps_estimated) : fmt.pct(ev.surprise) + ' vs prognose' %></em></div>
    <div><span>Omzet</span><b><%= fmt.money(ev.revenue_actual) %></b><em class="small <%= fmt.tone(ev.revSurprise) %>"><%= ev.revSurprise == null ? '' : fmt.pct(ev.revSurprise) + ' vs prognose' %></em></div>
    <div><span>Koersreactie</span><b class="<%= fmt.tone(ev.reaction) %>"><%= fmt.pct(ev.reaction) %></b><em class="small muted">dag ervoor tot dag erna</em></div>
    <div><span>Koersdoelen erna</span><b><span class="pos">▲<%= ev.raises %></span> <span class="neg">▼<%= ev.cuts %></span></b><em class="small muted">verhoogd / verlaagd</em></div>
  </div>
  <% } %>

  <div class="ct-grid">
    <div class="ct-main">
      <% if (intro) { %><h3 class="syn-h"><%= nl ? 'Wat het management vertelde' : 'Onze analyse' %></h3><p class="ct-intro"><%= intro %></p><% } %>
      <% if (kps.length) { %>
      <h3 class="syn-h">Belangrijk voor beleggers</h3>
      <ul class="ct-kp"><% kps.forEach(function (k) { %><li><%= k.text %></li><% }) %></ul>
      <% } %>
      <% if (outl.length) { %>
      <h3 class="syn-h">Prognose van het management</h3>
      <ul class="ct-kp ct-out"><% outl.forEach(function (k) { %><li><%= k.text %></li><% }) %></ul>
      <% } %>
    </div>
    <div class="ct-viz">
      <div class="ct-box">
        <div class="ct-box-h"><span>Toon van het management</span><% if (cc && cc.toneMgmt != null && Math.abs(cc.toneMgmt) >= 0.05) { %><em class="small <%= fmt.tone(cc.toneMgmt) %>"><%= cc.toneMgmt > 0 ? '▲ positiever' : '▼ minder positief' %> dan vorige call</em><% } %></div>
        <div class="ct-gauge" data-tip="Toon van het management&#10;<%= ca.tone.mgmt.pos %> positieve en <%= ca.tone.mgmt.neg %> negatieve woorden<%= tonePrev != null ? '&#10;Streepje = vorige call' : '' %>"><%- callCharts.toneGauge(toneNow, tonePrev) %><b class="<%= fmt.tone(ca.tone.mgmt.net) %>"><%= tr.toneWord(ca.tone.mgmt.net) %></b></div>
        <% var spark = callCharts.toneSpark(callTeaser.toneHist); if (spark) { %><div class="ct-spark"><span class="small muted">Toon in de laatste <%= callTeaser.toneHist.length %> calls</span><div class="only-desk"><%- spark %></div><div class="only-phone"><%- callCharts.toneSpark(callTeaser.toneHist, { width: 300, height: 80 }) %></div></div><% } %>
      </div>
      <% if (topics.length) { %>
      <div class="ct-box">
        <div class="ct-box-h"><span>Waar ging het over?</span><em class="small muted"><%= ca.exchanges.length %> vragen van <%= ca.analysts.length %> analisten</em></div>
        <div class="ct-topics">
        <% topics.forEach(function (t) { var d = t.p == null ? null : t.v - t.p; %>
          <div class="ct-t" data-tip="<%= t.label %>&#10;<%= Math.round(t.v) %> keer per 10.000 woorden<%= d != null ? '&#10;Vorige call: ' + Math.round(t.p) : '' %>"><span class="ct-t-l"><%= t.label %></span><span class="ct-t-b"><i style="width:<%= Math.max(4, t.v / tMax * 100).toFixed(0) %>%"></i></span><span class="ct-t-d <%= d == null || Math.abs(d) < 3 ? 'muted' : d > 0 ? 'pos' : 'neg' %>"><%= d == null || Math.abs(d) < 3 ? '' : d > 0 ? '▲' : '▼' %></span></div>
        <% }) %>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <a class="ct-cta" href="<%= callTeaser.href %>">
    <span class="ct-cta-t">
      <b>Lees de hele call: <%= ca.exchanges.length %> vragen en alle antwoorden<%= nl ? ' in het Nederlands' : '' %></b>
      <span><% if (ex) { %>Wat wilde <%= ex.analyst %><%= ex.firm ? ' van ' + ex.firm : '' %> weten<%= exTopic ? ' over ' + exTopic : '' %>, en wat antwoordde <%= ex.answeredBy && ex.answeredBy[0] ? ex.answeredBy[0] : 'het management' %>? Lees het verslag.<% } else { %>Alle vragen van analisten en de antwoorden van het management op een rij.<% } %></span>
    </span>
    <span class="ct-cta-go" aria-hidden="true">→</span>
  </a>
  <p class="small mb0 ct-more"><a href="/aandeel/<%= encodeURIComponent(symbol) %>/earnings-calls">Vergelijk alle earnings calls van <%= name %> →</a></p>
</section>
