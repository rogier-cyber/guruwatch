<%# Voortgangsbalk van startkoers naar koersdoel, met de huidige koers als stip. c = call met withLive %>
<% var pg = c.progress == null ? null : Math.max(-0.25, Math.min(1.25, c.progress)); var reached = c.progress != null && c.progress >= 1; %>
<div class="cp<%= reached ? ' cp-hit' : '' %><%= c.progress != null && c.progress < 0 ? ' cp-wrong' : '' %>">
  <div class="cp-track">
    <span class="cp-fill" style="width:<%= pg == null ? 0 : Math.max(0, Math.min(100, pg * 80)).toFixed(1) %>%"></span>
    <span class="cp-goal" title="Koersdoel <%= fmt.price(c.target) %>"></span>
    <% if (pg != null) { %><span class="cp-dot" style="left:<%= Math.max(0, Math.min(100, pg * 80)).toFixed(1) %>%" title="Nu <%= fmt.price(c.price_now) %>"></span><% } %>
  </div>
  <div class="cp-lbl"><span><%= fmt.price(c.p0) %></span><span class="cp-t"><%= fmt.price(c.target) %></span></div>
</div>
