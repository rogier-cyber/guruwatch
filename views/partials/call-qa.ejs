<% var list = locals.max ? exchanges.slice(0, max) : exchanges; var show = locals.show || 6; %>
<div class="qa-acc-list">
<% list.forEach(function (e, i) { var l = locals.links && links.get(e.analyst.toLowerCase()); %>
  <details class="qa-acc<%= i >= show ? ' more-item' : '' %>"<%= i >= show ? ' hidden' : '' %>>
    <summary>
      <div class="qa-sum">
        <div class="qa-who"><%- ui.avatar(e.analyst, e.firm) %><% if (l) { %><a href="/analist/<%= l.slug %>" data-tip-touch="0" data-tip="<%= e.analyst %>&#10;<%= l.firm || e.firm || '' %><%= l.score != null ? '&#10;GuruScore ' + Math.round(l.score) : '' %>"><b><%= e.analyst %></b></a><% } else { %><b><%= e.analyst %></b><% } %><span class="muted small"> analist<%= e.firm ? ' bij ' + e.firm : '' %></span><% e.topics.forEach(function (t) { %> <span class="tp-chip sm"><%= tr.topicLabel(t) %></span><% }) %></div>
        <% var qps = fmt.paras(fullText && e.question ? e.question : e.excerpt, 300); %><div class="qa-q"><% qps.forEach(function (t, k) { %><p><%= k === 0 ? '“' : '' %><%= t %><%= k === qps.length - 1 ? '”' : '' %></p><% }) %></div>
        <% if (e.answeredBy.length) { var tt = locals.titles || {}; var names = e.answeredBy.map(function (n) { return tr.withTitle(n, tt); }); var who = names.length > 1 ? names.slice(0, -1).join(', ') + ' en ' + names[names.length - 1] : names[0]; %><span class="qa-btn"><span class="qa-btn-open">Lees antwoord van <%= who %></span><span class="qa-btn-close">Verberg antwoord</span><i aria-hidden="true"></i></span> <span class="small muted qa-len"><%= e.answerWords %> woorden</span><% } else { %><span class="qa-btn"><span class="qa-btn-open">Bekijk details</span><span class="qa-btn-close">Verberg</span><i aria-hidden="true"></i></span><% } %>
      </div>
      <span class="faq-chev" aria-hidden="true"></span>
    </summary>
    <div class="qa-ans">
      <% if (!e.answers || !e.answers.length) { %><p class="small muted">Geen antwoord gevonden.</p><% } else { e.answers.forEach(function (an) { var x = fullText ? { text: an.text, cut: false } : tr.excerpt(an.text, 90); %>
        <% var ps = fmt.paras(x.text); ps.forEach(function (t, k) { %><p><% if (!k) { %><b><%= tr.withTitle(an.speaker, locals.titles) %>:</b> <% } %><%= t %><% if (x.cut && k === ps.length - 1) { %> <span class="muted">[…]</span><% } %></p><% }) %>
      <% }) } %>
    </div>
  </details>
<% }) %>
</div>
<% if (list.length > show) { %><button class="more-btn" data-more>Meer vragen (<%= list.length - show %>)</button><% } %>
<% if (list.some(function (e) { return e.nl; })) { %><p class="small muted mb0">Vragen en antwoorden vertaald door AI (Claude) uit het Engelse transcript.</p><% } %>
<% if (!fullText) { %><p class="small muted mb0">Antwoorden zijn ingekort tot het begin. De volledige tekst tonen we zodra de licentie daarvoor rond is.</p><% } %>
