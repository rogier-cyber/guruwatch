<%- include('partials/head') %>
<div class="page-head">
  <div>
    <h1 class="page-title"><%= fund.manager %></h1>
    <p class="muted"><%= fund.name %> · CIK <%= fund.cik %><% if (period) { %> · 13F per <%= fmt.date(period) %><% } %></p>
  </div>
  <%- include('partials/watch', { kind: 'fund', ref: fund.slug, watched: watched }) %>
</div>
<% if (!period) { %>
  <p class="alert">Er is (nog) geen 13F-data voor dit fonds gevonden.</p>
<% } else { var nNew = positions.filter(function (p) { return p.change === 'new'; }).length; var nAdd = positions.filter(function (p) { return p.change === 'added'; }).length; var nRed = positions.filter(function (p) { return p.change === 'reduced'; }).length; %>
<div class="stats">
  <div class="stat"><span>Portefeuille</span><strong><%= fmt.money(total) %></strong></div>
  <div class="stat"><span>Posities</span><strong><%= positions.length %></strong></div>
  <div class="stat"><span>Nieuw / bijgekocht</span><strong class="pos"><%= nNew %> / <%= nAdd %></strong></div>
  <div class="stat"><span>Verlaagd / verkocht</span><strong class="neg"><%= nRed %> / <%= sold.length %></strong></div>
</div>
<section class="card">
  <h2>Posities<% if (prevPeriod) { %> <span class="muted small">t.o.v. <%= fmt.date(prevPeriod) %></span><% } %></h2>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>Aandeel</th><th>Naam</th><th class="r">Gewicht</th><th class="r">Waarde</th><th class="r">Aantal</th><th>Wijziging</th></tr></thead>
    <tbody>
    <% positions.forEach(function (p) { %>
      <tr><td><% if (p.symbol) { %><%- include('partials/sym', { s: p.symbol }) %><% } else { %><span class="muted"><%= p.cusip %></span><% } %></td>
      <td><%= p.issuer %><% if (p.put_call) { %> <span class="tag neutral"><%= p.put_call %></span><% } %></td>
      <td class="r"><div class="bar"><span style="width:<%= Math.min(100, Number(p.weight) * 100 / Math.max(Number(positions[0].weight) || 1e-9, 1e-9)).toFixed(1) %>%"></span></div><%= fmt.pct(p.weight, false) %></td>
      <td class="r"><%= fmt.money(p.value) %></td><td class="r"><%= fmt.num(p.shares) %></td>
      <td><% if (!prevPeriod) { %><% } else if (p.change === 'new') { %><span class="tag pos">Nieuw</span><% } else if (p.change === 'added') { %><span class="tag pos">+<%= fmt.pct(p.change_pct, false) %></span><% } else if (p.change === 'reduced') { %><span class="tag neg"><%= fmt.pct(p.change_pct) %></span><% } else { %><span class="muted">–</span><% } %></td></tr>
    <% }) %>
    </tbody></table></div>
</section>
<% if (sold.length) { %>
<section class="card">
  <h2>Volledig verkocht</h2>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Aandeel</th><th>Naam</th><th class="r">Aantal vorig kwartaal</th></tr></thead><tbody>
  <% sold.forEach(function (p) { %><tr><td><% if (p.symbol) { %><%- include('partials/sym', { s: p.symbol }) %><% } %></td><td><%= p.issuer %></td><td class="r"><%= fmt.num(p.prev_shares) %></td></tr><% }) %>
  </tbody></table></div>
</section>
<% } %>
<% } %>
<%- include('partials/foot') %>
