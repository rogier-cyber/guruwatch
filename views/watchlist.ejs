<%- include('partials/head') %>
<h1 class="page-title">Volglijst</h1>
<% if (!items.length) { %>
<section class="card"><p>Je volgt nog niets. Klik op <strong>☆ Volgen</strong> bij een aandeel, analist of fonds.</p></section>
<% } else { %>
<section class="card">
  <div class="chips">
  <% items.forEach(function (i) { %>
    <% if (i.kind === 'stock') { %><a class="chip" href="/aandeel/<%= encodeURIComponent(i.ref) %>"><%= i.ref %></a>
    <% } else if (i.kind === 'analyst') { %><a class="chip" href="/analist/<%= i.ref %>">Analist: <%= i.ref.replace(/-/g, ' ') %></a>
    <% } else { var f = fundMap.get(i.ref); %><a class="chip" href="/fonds/<%= i.ref %>">Fonds: <%= f ? f.manager : i.ref %></a><% } %>
  <% }) %>
  </div>
</section>
<div class="grid2">
  <section class="card"><h2>Laatste ratings op je aandelen</h2><%- include('partials/grades', { rows: grades }) %></section>
  <section class="card"><h2>Laatste insider trades op je aandelen</h2><%- include('partials/insiders', { rows: insiders }) %></section>
</div>
<% } %>
<%- include('partials/foot') %>
