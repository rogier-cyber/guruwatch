<%- include('partials/head') %>
<section class="hero">
  <div class="hero-in">
    <div>
      <h1 class="no-bars">Welke guru geeft je een <b>voorsprong</b>?</h1>
      <p>Guruwatch volgt drie soorten guru's: analisten met hun koersdoelen en adviezen, beleggersguru's zoals Warren Buffett, en insiders die aandelen van hun eigen bedrijf kopen of verkopen.</p>
      <form action="/zoek" method="get" role="search"><input name="q" placeholder="Zoek een aandeel, analist, bank of fonds" aria-label="Zoeken"></form>
    </div>
    <div class="hero-kpis">
      <div class="hk"><span>Koersdoelen verhoogd (30 d)</span><strong><%= fmt.num(kpi.raised) %></strong> <em class="down">/ <%= fmt.num(kpi.lowered) %> verlaagd</em><%- charts.miniLine(revisionDays.map(function (d) { return d.pos - d.neg; }), { width: 200, height: 26, cls: 'light' }) %></div>
      <div class="hk"><span>Upgrades vs downgrades (30 d)</span><strong class="up"><%= fmt.num(kpi.upgrades) %></strong> <em class="down">/ <%= fmt.num(kpi.downgrades) %></em><%- charts.miniLine(gradeDays.map(function (d) { return d.pos - d.neg; }), { width: 200, height: 26, cls: 'light' }) %></div>
      <div class="hk"><span>Insiders kochten (30 d)</span><strong><%= fmt.money(kpi.insiderBuy) %></strong> <em class="down">verkochten <%= fmt.money(kpi.insiderSell) %></em></div>
      <% var moodN = kpi.upgrades + kpi.downgrades + kpi.raised + kpi.lowered; var mood = moodN ? (kpi.upgrades + kpi.raised) / moodN : 0.5; var moodTxt = mood >= 0.65 ? 'Uitbundig' : mood >= 0.5 ? 'Positief' : mood >= 0.35 ? 'Voorzichtig' : 'Somber'; %>
      <div class="hk hk-mood"><span>Stemming analisten (30 d)</span><div class="hk-mg"><%- viz.moodGauge(mood, { width: 120, label: 'Stemming analisten: ' + moodTxt }) %><div><strong><%= moodTxt %></strong><em><%= fmt.pct(mood, false) %> positief</em></div></div></div>
    </div>
  </div>
</section>

<div class="trio">
  <a href="/analisten"><span class="gw-guru gw-guru-navy trio-g" aria-hidden="true"></span><div><h2>Analisten</h2><p>Koersdoelen, up- en downgrades van banken en brokers. Elke analist afgerekend op zijn trackrecord met de GuruScore.</p><em><%= fmt.num(counts.analysts) %> analisten →</em></div></a>
  <a href="/gurus"><span class="gw-guru gw-guru-red trio-g" aria-hidden="true"></span><div><h2>Beleggersguru's</h2><p>Wat Warren Buffett en andere bekende beleggers en hedge funds in portefeuille hebben, kochten en verkochten.</p><em><%= fmt.num(counts.funds) %> guru's →</em></div></a>
  <a href="/insiders"><span class="gw-guru gw-guru-gold trio-g" aria-hidden="true"></span><div><h2>Insiders</h2><p>Bestuurders en grootaandeelhouders die aandelen van hun eigen bedrijf kopen of verkopen. Plus aandelen waar meerdere insiders tegelijk kopen.</p><em>Laatste transacties →</em></div></a>
</div>

<% if (!counts.targets && !counts.insiders) { %>
<p class="alert info">De eerste data wordt op de achtergrond binnengehaald. Ververs over een paar minuten. Voortgang zie je op <a href="/status">Status</a>.</p>
<% } %>

<div class="grid3">
  <section class="card">
    <div class="card-h"><h2>Topanalisten</h2><a href="/analisten" class="small">Ranglijst</a></div>
    <% if (!top.length) { %><p class="empty">De GuruScore wordt nog berekend.</p><% } else { %>
    <div class="stack" style="gap:10px">
    <% top.forEach(function (a) { %>
      <a class="id-row" href="/analist/<%= a.slug %>" style="color:inherit;text-decoration:none">
        <%- charts.scoreRing(a.score, 42) %>
        <div><strong><%= a.name %></strong><div class="muted small"><%= a.firm %> · trefkans <%= fmt.pct(a.hit_rate, false) %></div></div>
      </a>
    <% }) %>
    </div><% } %>
  </section>
  <section class="card">
    <div class="card-h"><h2>Analistensentiment</h2><span class="chart-legend"><span><i class="sw-buy"></i>Upgrades</span><span><i class="sw-sell"></i>Downgrades</span></span></div>
    <%- charts.divergingBars(gradeDays, { width: 380, height: 150, posLabel: 'upgrades', negLabel: 'downgrades' }) %>
    <p class="small muted">Per dag, laatste 30 dagen.</p>
  </section>
  <section class="card">
    <div class="card-h"><h2>Insiders: kopen vs verkopen</h2><a href="/insiders" class="small">Alles</a></div>
    <%- charts.divergingBars(insiderDays, { width: 380, height: 150, fmt: fmt.money, posLabel: 'gekocht', negLabel: 'verkocht', sqrt: true }) %>
    <p class="small muted">Waarde per dag, laatste 30 dagen.</p>
  </section>
</div>

<% if (radarTop.length || radarBottom.length) { %>
<section class="card mt">
  <div class="card-h"><h2>Radar: waar draait het sentiment?</h2><a href="/analisten?tab=radar" class="small">Naar de radar</a></div>
  <div class="grid2 rd-home">
    <div>
      <p class="small muted"><span class="dot-pos"></span>Favoriet bij analisten, laatste 30 dagen</p>
      <%- charts.hbars(radarTop.map(function (r) { return { sym: r.symbol, name: r.name, value: r.score, display: '▲' + (r.raises + r.ups) + ' ▼' + (r.cuts + r.downs), href: '/aandeel/' + encodeURIComponent(r.symbol) }; }), { cls: 'hbars-wide hbars-pos' }) %>
    </div>
    <div>
      <p class="small muted"><span class="dot-neg"></span>Sentiment verslechtert</p>
      <div class="hbars-neg"><%- charts.hbars(radarBottom.map(function (r) { return { sym: r.symbol, name: r.name, value: -r.score, display: '▲' + (r.raises + r.ups) + ' ▼' + (r.cuts + r.downs), href: '/aandeel/' + encodeURIComponent(r.symbol) }; }), { cls: 'hbars-wide' }) %></div>
    </div>
  </div>
</section>
<% } %>

<div class="grid2 mt">
  <section class="card">
    <div class="card-h"><h2>Up- en downgrades</h2><a href="/analisten?tab=ratings" class="small">Alles</a></div>
    <%- include('partials/grades', { rows: grades, compact: true }) %>
  </section>
  <section class="card">
    <div class="card-h"><h2>Nieuwe koersdoelen</h2><a href="/analisten?tab=koersdoelen" class="small">Alles</a></div>
    <%- include('partials/targets', { rows: activity }) %>
  </section>
  <section class="card">
    <div class="card-h"><h2>Meerdere insiders kopen</h2><a href="/insiders" class="small">Insiders</a></div>
    <p class="small muted">Aandelen waar de afgelopen 30 dagen meerdere bestuurders of grootaandeelhouders eigen aandelen kochten. Als meerdere insiders tegelijk kopen, is dat historisch een sterker signaal dan één losse aankoop: zij kennen het bedrijf het best en zetten er samen eigen geld op in.</p>
    <% if (!clusters.length) { %><p class="empty">Nog geen data.</p><% } else { %>
    <%- charts.hbars(clusters.map(function (c) { return { sym: c.symbol, name: c.name, value: c.insiders, display: c.insiders + (c.insiders === 1 ? ' insider · ' : ' insiders · ') + fmt.money(c.value) + ' gekocht', href: '/aandeel/' + encodeURIComponent(c.symbol) }; })) %>
    <% } %>
  </section>
  <section class="card">
    <% if (together.length) { %>
    <div class="card-h"><h2>Guru's kochten samen</h2><a href="/gurus" class="small">Alle guru's</a></div>
    <p class="small muted">Nieuw of flink bijgekocht door 2+ guru's in hun laatste 13F.</p>
    <div class="tg-list">
      <% together.slice(0, 8).forEach(function (t, i) { %>
      <div class="tg-row">
        <span class="tg-n"><%= i + 1 %></span>
        <%- ui.stock(t.symbol, t.name) %>
        <span class="tg-who" title="<%= t.managers.join(', ') %>"><%= t.managers.slice(0, 2).join(', ') %><%= t.managers.length > 2 ? ' +' + (t.managers.length - 2) : '' %></span>
        <span class="tg-c"><b><%= t.gurus %></b> guru's</span>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="card-h"><h2>Favoriet bij de guru's</h2><a href="/gurus" class="small">Alle guru's</a></div>
    <p class="small muted">Meest gehouden door de gevolgde hedge funds.</p>
    <% if (!popular.length) { %><p class="empty">Nog geen 13F-data.</p><% } else { %>
    <%- charts.hbars(popular.map(function (p) { return { sym: p.symbol, name: p.name, value: p.funds, display: p.funds + ' fondsen · ' + fmt.money(p.value), href: '/aandeel/' + encodeURIComponent(p.symbol) }; })) %>
    <% } %>
    <% } %>
  </section>
</div>
<%- include('partials/foot') %>
