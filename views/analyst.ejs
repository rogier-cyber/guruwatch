<%- include('partials/head') %>
<div class="page-head">
  <div class="id-row">
    <%- include('partials/score', { score: guru && guru.score }) %>
    <div>
      <h1 class="page-title"><%= analyst.name %></h1>
      <p class="muted"><% if (analyst.firm) { %><a href="/bank/<%= encodeURIComponent(analyst.firm) %>"><%= analyst.firm %></a><% if (firmScore) { %> (bank-score <%= Math.round(firmScore.score) %>)<% } %> · <% } %><%= calls.length %> koersdoelen · <%= symbols.length %> aandelen<% if (guru) { %> · nr. <%= guru.rank %> van alle analisten<% } %></p>
    </div>
  </div>
  <%- include('partials/watch', { kind: 'analyst', ref: analyst.slug, watched: watched }) %>
</div>
<div class="stats">
  <div class="stat"><span>GuruScore</span><strong><%= guru ? Math.round(guru.score) + ' / 100' : '–' %></strong><em class="small"><a href="/methode">Hoe berekend?</a></em></div>
  <div class="stat"><span>Beoordeelde adviezen</span><strong><%= guru ? guru.calls : 0 %></strong></div>
  <div class="stat"><span>Trefkans (12 mnd)</span><strong><%= fmt.pct(guru && guru.hit_rate, false) %></strong></div>
  <div class="stat"><span>Gem. rendement</span><strong class="<%= fmt.tone(guru && guru.avg_return) %>"><%= fmt.pct(guru && guru.avg_return) %></strong></div>
  <div class="stat"><span>Vs. S&amp;P 500</span><strong class="<%= fmt.tone(guru && guru.avg_excess) %>"><%= fmt.pct(guru && guru.avg_excess) %></strong></div>
</div>
<div class="grid-side">
  <section class="card">
    <h2>Koersdoelen</h2>
    <div class="tbl-wrap"><table class="tbl">
      <thead><tr><th>Datum</th><th>Aandeel</th><th class="r">Koersdoel</th><th class="r">Koers toen</th><th class="r">Rendement</th><th class="r">Vs. S&amp;P</th><th>Uitkomst</th></tr></thead>
      <tbody>
      <% calls.forEach(function (t) { var up = t.prev_target && Number(t.price_target) > Number(t.prev_target); var down = t.prev_target && Number(t.price_target) < Number(t.prev_target); %>
        <tr><td class="muted nowrap"><%= fmt.date(t.published_at) %></td><td><%- include('partials/sym', { s: t.symbol }) %></td>
        <td class="r nowrap"><% if (t.prev_target && Number(t.prev_target) !== Number(t.price_target)) { %><span class="muted"><%= fmt.price(t.prev_target) %></span> <span class="<%= up ? 'pos' : 'neg' %>"><%= up ? '↑' : '↓' %></span> <% } %><strong><%= fmt.price(t.price_target) %></strong></td>
        <td class="r"><%= fmt.price(t.price_when_posted) %></td>
        <td class="r <%= fmt.tone(t.ret) %>"><%= t.ret !== null ? fmt.pct(t.ret) : '–' %></td>
        <td class="r <%= fmt.tone(t.excess) %>"><%= t.excess !== null ? fmt.pct(t.excess) : '–' %></td>
        <td><% if (t.hit === true) { %><span class="tag pos">Doel gehaald<%= t.days_to_hit ? ' (' + t.days_to_hit + ' d)' : '' %></span><% } else if (t.hit === false && t.complete) { %><span class="tag neg">Niet gehaald</span><% } else if (t.hit === false) { %><span class="tag neutral">Loopt nog</span><% } else { %><span class="muted small">Te recent</span><% } %></td></tr>
      <% }) %>
      </tbody></table></div>
  </section>
  <aside class="card">
    <h2>Per aandeel</h2>
    <% if (!bySymbol.length) { %><p class="empty">Nog geen beoordeelde adviezen.</p><% } else { %>
    <table class="tbl"><thead><tr><th>Aandeel</th><th class="r">#</th><th class="r">Treffers</th><th class="r">Vs. S&amp;P</th></tr></thead><tbody>
    <% bySymbol.forEach(function (b) { %><tr><td><%- include('partials/sym', { s: b.symbol }) %></td><td class="r"><%= b.calls %></td><td class="r"><%= fmt.pct(b.hit_rate, false) %></td><td class="r <%= fmt.tone(b.avg_excess) %>"><%= fmt.pct(b.avg_excess) %></td></tr><% }) %>
    </tbody></table><% } %>
  </aside>
</div>
<%- include('partials/foot') %>
