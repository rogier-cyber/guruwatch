<%- include('partials/head') %>
<h1 class="page-title"><%= firm %></h1>
<% if (leaders.length) { %>
<section class="card">
  <h2>Analisten van <%= firm %></h2>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Analist</th><th class="r">Beoordeeld</th><th class="r">Goede richting</th><th class="r">Gem. rendement</th></tr></thead><tbody>
  <% leaders.forEach(function (a) { %><tr><td><a href="/analist/<%= a.slug %>" class="strong"><%= a.name %></a></td><td class="r"><%= a.scored %></td><td class="r"><%= fmt.pct(a.success_rate, false) %></td><td class="r <%= fmt.tone(a.avg_return) %>"><%= fmt.pct(a.avg_return) %></td></tr><% }) %>
  </tbody></table></div>
</section>
<% } %>
<section class="card">
  <h2>Ratings</h2>
  <%- include('partials/grades', { rows: grades, hideFirm: true }) %>
</section>
<%- include('partials/foot') %>
