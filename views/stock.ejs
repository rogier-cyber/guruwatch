<%- include('partials/head') %>
<nav class="crumbs small" aria-label="Kruimelpad"><a href="/aandelen">Aandelen</a><% if (crumbIndex) { %> <span aria-hidden="true">›</span> <a href="/aandelen?index=<%= crumbIndex.key %>"><%= crumbIndex.label %></a><% } %> <span aria-hidden="true">›</span> <span aria-current="page"><%= name %></span></nav>
<div class="page-head">
  <div class="stock-id">
    <img src="<%= logo %>" alt="Logo <%= name %>" class="stock-logo" width="52" height="52" onerror="this.style.display='none'">
    <div>
      <h1 class="page-title stock-name"><span class="h1-k">Aandeel</span> <%= name %> <span class="stock-tk"><%= symbol %></span></h1>
      <p class="muted"><%= profile ? [profile.exchange, profile.sector, profile.industry].filter(Boolean).join(' · ') : '' %></p>
    </div>
  </div>
  <%- include('partials/watch', { kind: 'stock', ref: symbol, watched: watched }) %>
</div>

<div class="stats">
  <div class="stat"><span>Koers</span><strong><%= fmt.price(quote && quote.price) %></strong><em class="<%= fmt.tone(quote && quote.changePercentage) %>"><%= quote ? fmt.pct(quote.changePercentage / 100) : '' %></em></div>
  <div class="stat"><span>Gem. koersdoel</span><strong><%= fmt.price(consensus && consensus.targetConsensus) %></strong><% if (consensus && quote && consensus.targetConsensus) { var up = consensus.targetConsensus / quote.price - 1; %><em class="<%= fmt.tone(up) %>"><%= fmt.pct(up) %> upside</em><% } %></div>
  <div class="stat"><span>Spreiding doelen</span><strong><%= consensus ? fmt.price(consensus.targetLow) + ' – ' + fmt.price(consensus.targetHigh) : '–' %></strong></div>
  <div class="stat"><span>Consensus</span><strong><%= gradesConsensus && gradesConsensus.consensus || '–' %></strong>
    <% if (gradesConsensus) { %><em class="small"><span class="pos"><%= (gradesConsensus.strongBuy || 0) + (gradesConsensus.buy || 0) %> kopen</span> · <%= gradesConsensus.hold || 0 %> houden · <span class="neg"><%= (gradesConsensus.sell || 0) + (gradesConsensus.strongSell || 0) %> verkopen</span></em><% } %></div>
  <div class="stat"><span>Marktwaarde</span><strong><%= fmt.money(profile && (profile.marketCap || profile.mktCap)) %></strong></div>
</div>

<% if (story.faq.length) { %>
<nav class="qbar" aria-label="Snel naar een vraag">
  <span class="qbar-k">Vragen over <%= name %></span>
  <div class="qbar-list"><% story.faq.slice(0, 8).forEach(function (f) { %><a href="#vraag-<%= f.id %>" title="<%= f.q %>"><%= f.chip %></a><% }) %><a href="#vragen" class="qbar-all">Alle vragen ↓</a></div>
</nav>
<% } %>
<% var nowR = rot[0]; var nc = nowR.counts; var sx = story.sections || {}; %>
<% if (nc || nowR.target) { %>
<section class="card av-hero">
  <div class="av-sum">
    <div class="av-verdict">
      <span class="av-k">Analistenoordeel</span>
      <strong class="vt vt-<%= nowR.verdict ? nowR.verdict.tone : 'na' %>"><%= nowR.verdict ? nowR.verdict.label : 'Nog geen oordeel' %></strong>
      <% if (nowR.score) { %><em class="small muted">score <%= nowR.score.toFixed(2).replace('.', ',') %> op een schaal van 1 tot 5</em><% } %>
    </div>
    <div class="av-kpis">
      <div><span class="av-k">Gem. koersdoel</span><strong><%= fmt.price(nowR.target) %></strong></div>
      <div><span class="av-k">Potentieel</span><strong class="<%= fmt.tone(nowR.upside) %>"><%= nowR.upside === null ? '–' : (nowR.upside >= 0 ? '▲ ' : '▼ ') + fmt.pct(nowR.upside) %></strong></div>
      <div><span class="av-k">Analisten</span><strong><%= nc ? nc.total : (nowR.analysts || '–') %></strong><em class="small muted"><%= nowR.analysts ? nowR.analysts + ' met koersdoel' : '' %></em></div>
    </div>
    <% if (nc) { %>
    <div class="av-dist">
      <%- charts.ratingBar(nc, { height: 12 }) %>
      <p class="small muted"><span class="pos"><%= nc.strong_buy + nc.buy %> kopen</span> · <%= nc.hold %> houden · <span class="neg"><%= nc.sell + nc.strong_sell %> verkopen</span></p>
    </div>
    <% } %>
  </div>
  <% if (nc) { %><div class="av-chart"><%- charts.ratingDist(nc, { width: 340, height: 180 }) %></div><% } %>
</section>
<% } %>

<% if (fan) { %>
<section class="card">
  <div class="card-h"><h2>Verwachtingen voor de koers van <%= name %></h2><span class="small muted">beweeg over een stip voor het advies</span></div>
  <% if (story.forecast) { %><p class="fc-txt"><%= story.forecast.text %></p><% } %>
  <%- fan %>
  <p class="small muted">Links de koers van het afgelopen jaar, rechts waar analisten het aandeel over twaalf maanden zien: hoogste, gemiddelde en laagste koersdoel. Elke stip is het laatste koersdoel van één analist (groen = positief advies, rood = negatief).</p>
</section>
<% } %>

<% if (story && (story.summary.length || story.bull.length || story.bear.length)) { %>
<section class="card story">
  <h2>Wat je moet weten over <%= name %></h2>
  <% story.summary.forEach(function (p) { %><p><%= p %></p><% }) %>
</section>
<div class="grid2 cases">
  <section class="card case case-bull">
    <div class="case-h"><div><span class="case-k"><%= name %></span><h2>Bull case</h2></div><svg viewBox="0 0 64 40" class="case-ic" aria-hidden="true"><path d="M6 30c4-9 13-14 24-14h12c6 0 10-3 12-8 2 4 1 8-2 11l4 3-4 2c-2 3-6 5-10 5l-2 7h-4l-1-6h-12l-2 6h-4l-1-7c-4-1-7 0-10 1z"/><path d="M50 8c1-3 4-5 7-5"/></svg></div>
    <p class="small muted">Waarom beleggers positief kunnen zijn over <%= name %>:</p>
    <% if (story.bull.length) { %><ul><% story.bull.forEach(function (b) { %><li><%= b %></li><% }) %></ul><% } else { %><p class="empty">Er springen nu geen duidelijk positieve signalen uit de data.</p><% } %>
  </section>
  <section class="card case case-bear">
    <div class="case-h"><div><span class="case-k"><%= name %></span><h2>Bear case</h2></div><svg viewBox="0 0 64 40" class="case-ic" aria-hidden="true"><path d="M8 30c0-9 8-16 20-16h14c7 0 12 4 14 10l4 2-2 4h-4l-2 8h-4l-1-6h-16l-2 6h-4l-1-7c-5 0-10 1-16-1z"/><circle cx="54" cy="22" r="1.5"/></svg></div>
    <p class="small muted">Waarom beleggers voorzichtig kunnen zijn met <%= name %>:</p>
    <% if (story.bear.length) { %><ul><% story.bear.forEach(function (b) { %><li><%= b %></li><% }) %></ul><% } else { %><p class="empty">Er springen nu geen duidelijk negatieve signalen uit de data.</p><% } %>
  </section>
</div>
<p class="small muted story-note">Deze tekst is automatisch samengesteld uit koersen, kwartaalcijfers, analistenadviezen en insidertransacties en wordt bij elk bezoek bijgewerkt. Geen beleggingsadvies.</p>
<% } %>

<% if (story.faq.length) { %>
<section class="card faq" id="vragen">
  <div class="card-h"><h2>Veelgestelde vragen over het aandeel <%= name %></h2><span class="small muted">bijgewerkt <%= fmt.date(new Date()) %></span></div>
  <div class="faq-grid">
  <% story.faq.forEach(function (f) { %><article class="faq-item" id="vraag-<%= f.id %>"><h3><%= f.q %></h3><p><%= f.a %></p></article><% }) %>
  </div>
</section>
<% } %>

<% var hasCols = months.filter(function (m) { return m.ratings; }).length >= 2; var hasBand = months.filter(function (m) { return m.mean; }).length >= 3; %>
<% if (hasCols || hasBand) { %>
<div class="grid2">
  <% if (hasCols) { %>
  <section class="card">
    <div class="card-h"><h2>Adviezen per maand</h2><span class="small muted">laatste 2 jaar</span></div>
    <% if (sx.ratings) { %><p class="sec-txt"><%= sx.ratings %></p><% } %>
    <%- charts.ratingColumns(months, { width: 560, height: 260 }) %>
    <p class="small rb-legend"><i class="rb-sb"></i>Sterk kopen <i class="rb-b"></i>Kopen <i class="rb-h"></i>Houden <i class="rb-s"></i>Verkopen <i class="rb-ss"></i>Sterk verkopen</p>
  </section>
  <% } %>
  <% if (hasBand) { %>
  <section class="card">
    <div class="card-h"><h2>Koersdoelen per maand</h2><span class="small muted">laatste 2 jaar</span></div>
    <% if (sx.targets) { %><p class="sec-txt"><%= sx.targets %></p><% } %>
    <%- charts.targetBand(months, { width: 560, height: 260 }) %>
    <p class="small tb-legend"><i class="p"></i>Koers <i class="t"></i>Gemiddeld koersdoel <i class="b"></i>Laagste tot hoogste koersdoel</p>
  </section>
  <% } %>
</div>
<% } %>

<% if (rot.some(function (r) { return r.counts || r.target; })) { var maxC = Math.max.apply(null, [1].concat(rot.map(function (r) { return r.counts ? Math.max(r.counts.strong_buy, r.counts.buy, r.counts.hold, r.counts.sell, r.counts.strong_sell) : 0; }))); %>
<section class="card">
  <div class="card-h"><h2>Adviezen voor <%= name %> door de tijd</h2></div>
  <% if (sx.rot) { %><p class="sec-txt"><%= sx.rot %></p><% } %>
  <div class="tbl-wrap"><table class="tbl rot">
    <thead><tr><th></th><% rot.forEach(function (r) { %><th><%= r.label %><span class="muted small rot-d"><%= fmt.date(r.date) %></span></th><% }) %></tr></thead>
    <tbody>
      <% [['strong_buy', 'Sterk kopen', 'rb-sb'], ['buy', 'Kopen', 'rb-b'], ['hold', 'Houden', 'rb-h'], ['sell', 'Verkopen', 'rb-s'], ['strong_sell', 'Sterk verkopen', 'rb-ss']].forEach(function (l) { %>
      <tr><th scope="row"><%= l[1] %></th><% rot.forEach(function (r) { var v = r.counts ? r.counts[l[0]] : null; %><td><% if (v === null) { %><span class="muted">–</span><% } else { %><span class="rot-n"><%= v %></span><i class="rot-bar <%= l[2] %>" style="width:<%= (v / maxC * 70).toFixed(0) %>px"></i><% } %></td><% }) %></tr>
      <% }) %>
      <tr><th scope="row">Gem. koersdoel</th><% rot.forEach(function (r) { %><td class="strong"><%= fmt.price(r.target) %></td><% }) %></tr>
      <tr><th scope="row">Potentieel <span class="muted small">t.o.v. koers toen</span></th><% rot.forEach(function (r) { %><td class="<%= fmt.tone(r.upside) %>"><%= r.upside === null ? '–' : (r.upside >= 0 ? '▲ ' : '▼ ') + fmt.pct(r.upside) %></td><% }) %></tr>
      <tr><th scope="row">Oordeel</th><% rot.forEach(function (r) { %><td><% if (r.verdict) { %><span class="vt-dot vt-<%= r.verdict.tone %>"></span><%= r.verdict.label %><% } else { %><span class="muted">–</span><% } %></td><% }) %></tr>
    </tbody>
  </table></div>
</section>
<% } %>
<% if (smart) { var pr = quote && Number(quote.price); var lo = Math.min(smart.low, pr || smart.low), hi = Math.max(smart.high, pr || smart.high); var pos = function (v) { return ((v - lo) / ((hi - lo) || 1) * 100).toFixed(1); }; %>
<section class="card">
  <div class="card-h"><h2>Consensus van <%= smart.count %> analisten</h2><a href="/methode" class="small">Hoe berekend?</a></div>
  <div class="cons-compare">
    <div><span class="muted small">Gewone consensus</span><strong><%= fmt.price(smart.mean) %></strong><em class="<%= fmt.tone(smart.upside) %>"><%= fmt.pct(smart.upside) %></em></div>
    <div class="smart"><span class="muted small">Slimme consensus <span class="hint" title="Alleen analisten met een GuruScore van 70 of hoger">ⓘ</span></span>
      <% if (smart.topMean) { %><strong><%= fmt.price(smart.topMean) %></strong><em class="<%= fmt.tone(smart.topUpside) %>"><%= fmt.pct(smart.topUpside) %> · <%= smart.topCount %> topanalist<%= smart.topCount === 1 ? '' : 'en' %></em><% } else { %><strong>–</strong><em class="muted">Geen topanalisten op dit aandeel</em><% } %></div>
    <div><span class="muted small">Mediaan</span><strong><%= fmt.price(smart.median) %></strong><em class="muted"><%= fmt.price(smart.low) %> – <%= fmt.price(smart.high) %></em></div>
  </div>
  <div class="band" role="img" aria-label="Spreiding van koersdoelen">
    <div class="band-range" style="left:<%= pos(smart.low) %>%;right:<%= (100 - pos(smart.high)) %>%"></div>
    <% if (pr) { %><div class="band-mk band-price" style="left:<%= pos(pr) %>%"><span>Koers <%= fmt.price(pr) %></span></div><% } %>
    <div class="band-mk band-mean" style="left:<%= pos(smart.mean) %>%"><span>Gem. <%= fmt.price(smart.mean) %></span></div>
    <% if (smart.topMean) { %><div class="band-mk band-top" style="left:<%= pos(smart.topMean) %>%"><span>Top <%= fmt.price(smart.topMean) %></span></div><% } %>
  </div>
  <div class="band-ends small muted"><span>Laagste <%= fmt.price(smart.low) %></span><span>Hoogste <%= fmt.price(smart.high) %></span></div>
</section>
<% } %>

<% if (actions.length) { %>
<section class="card">
  <div class="card-h"><h2>Upgrades, downgrades en koersdoelen voor <%= name %></h2><span class="small muted">recente acties van analisten</span></div>
  <% if (sx.actions) { %><p class="sec-txt"><%= sx.actions %></p><% } %>
  <div class="tbl-wrap"><table class="tbl acts">
    <thead><tr><th>Datum</th><th>Actie</th><th>Analist</th><th>Advies</th><th class="r">Koersdoel</th><th class="r">Potentieel</th></tr></thead>
    <tbody>
    <% actions.forEach(function (a) { var lv = a.level; var gt = lv >= 4 ? 'pos' : lv !== null && lv <= 2 ? 'neg' : ''; %>
      <tr>
        <td class="muted nowrap"><%= fmt.date(a.date) %></td>
        <td><span class="act act-<%= a.action.tone %>"><%= a.action.label %></span></td>
        <td><div class="id-row sm"><%- include('partials/score', { score: a.score }) %><div><% if (a.analyst_slug) { %><a href="/analist/<%= a.analyst_slug %>"><%= a.analyst %></a><div class="muted small"><%= a.firm %></div><% } else { %><% if (a.firm) { %><a href="/bank/<%= encodeURIComponent(a.firm) %>"><%= a.firm %></a><% } %><% if (a.analyst) { %><div class="muted small"><%= a.analyst %></div><% } %><% } %></div></div></td>
        <td class="nowrap <%= gt %>"><% if (a.to_grade) { %><% if (a.from_grade) { %><span class="muted"><%= a.from_grade %></span> → <% } %><%= a.to_grade %><% } else { %><span class="muted">–</span><% } %></td>
        <td class="r nowrap"><% if (a.to_target) { %><% if (a.from_target) { %><span class="muted"><%= fmt.price(a.from_target) %></span> → <% } %><strong class="<%= a.from_target ? (a.to_target > a.from_target ? 'pos' : 'neg') : '' %>"><%= fmt.price(a.to_target) %></strong><% } else { %><span class="muted">–</span><% } %></td>
        <td class="r nowrap <%= fmt.tone(a.upside) %>"><%= a.upside === null ? '–' : (a.upside >= 0 ? '▲ ' : '▼ ') + fmt.pct(a.upside) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</section>
<% } %>

<% if (compare.stock.score !== null && (compare.sector || compare.market)) { var cols = [compare.stock, compare.sector, compare.market].filter(Boolean); %>
<section class="card">
  <div class="card-h"><h2><%= name %> vergeleken met <%= compare.sector ? 'de sector en ' : '' %>de markt</h2></div>
  <% if (sx.compare) { %><p class="sec-txt"><%= sx.compare %></p><% } %>
  <div class="cmp" style="--cols:<%= cols.length %>">
    <div class="cmp-row cmp-head"><span></span><% cols.forEach(function (c, i) { %><span class="<%= i === 0 ? 'cmp-me' : '' %>"><%= i === 1 && compare.sector ? c.label : c.label %></span><% }) %></div>
    <div class="cmp-row"><span class="cmp-l">Oordeel van analisten</span><% cols.forEach(function (c) { %><span class="cmp-g"><%- charts.gauge(c.score, { size: 170, label: 'Oordeel' }) %></span><% }) %></div>
    <div class="cmp-row"><span class="cmp-l">Consensus</span><% cols.forEach(function (c) { var v = av.ratingLabel(c.score); %><span class="strong"><% if (v) { %><span class="vt-dot vt-<%= v.tone %>"></span><%= v.label %><% } else { %>–<% } %></span><% }) %></div>
    <div class="cmp-row"><span class="cmp-l">Potentieel <span class="muted small">(mediaan voor sector en markt)</span></span><% cols.forEach(function (c) { %><span class="<%= fmt.tone(c.upside) %> strong"><%= c.upside === null || c.upside === undefined ? '–' : (c.upside >= 0 ? '▲ ' : '▼ ') + fmt.pct(c.upside) %></span><% }) %></div>
    <div class="cmp-row"><span class="cmp-l">Analisten met koersdoel</span><% cols.forEach(function (c) { %><span><%= c.analysts ? Math.round(c.analysts) : '–' %></span><% }) %></div>
  </div>
  <p class="small muted"><%= compare.sector ? 'Sector: ' + compare.sector.stocks + ' aandelen. ' : '' %><%= compare.market ? 'Markt: ' + compare.market.stocks + ' aandelen met adviezen. ' : '' %>Oordeel van 1 (sterk verkopen) tot 5 (sterk kopen).</p>
</section>
<% } %>
<% if (peers && peers.length) { %>
<section class="card" id="vergelijkbaar">
  <div class="card-h"><h2>Vergelijkbare aandelen</h2><span class="small muted"><%= profile && profile.sector ? profile.sector : '' %></span></div>
  <% if (sx.peers) { %><p class="sec-txt"><%= sx.peers %></p><% } %>
  <div class="tbl-wrap"><table class="tbl peers-tbl">
    <thead><tr><th>Aandeel</th><th class="r">Koers</th><th class="r">Koersdoel</th><th class="r">Potentieel</th><th>Oordeel analisten</th></tr></thead>
    <tbody>
    <% peers.forEach(function (p) { %>
      <tr>
        <td><a class="sym" href="/aandeel/<%= encodeURIComponent(p.symbol) %>"><%= p.symbol %></a> <span class="muted small rd-name"><%= p.name || '' %></span></td>
        <td class="r nowrap"><%= fmt.price(p.price) %></td>
        <td class="r nowrap"><%= fmt.price(p.target) %></td>
        <td class="r nowrap <%= fmt.tone(p.upside) %>"><b><%= fmt.pct(p.upside) %></b></td>
        <td class="ix-sent"><% if (p.counts) { %><%- charts.ratingBar(p.counts, { height: 9 }) %><span class="small vt-txt vt-<%= p.verdict.tone %>"><%= p.verdict.label %></span><% } else { %><span class="muted small">geen adviezen</span><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <p class="small"><a href="/aandelen<%= crumbIndex ? '?index=' + crumbIndex.key : '' %>">Bekijk alle aandelen<%= crumbIndex ? ' uit de ' + crumbIndex.label : '' %> met hun koersdoelen →</a></p>
</section>
<% } %>
<% if (timeline) { %>
<% if ((earningsHist && earningsHist.length) || nextEarn) { %>
<section class="card">
  <div class="card-h"><h2>Kwartaalcijfers van <%= name %></h2><span class="small pb-legend"><i class="a"></i>Winstverrassing <i class="b"></i>Koersreactie</span></div>
  <% if (sx.earnings) { %><p class="sec-txt"><%= sx.earnings %></p><% } %>
  <% if (nextEarn) { %><p class="next-earn">Volgende cijfers: <b><%= fmt.date(nextEarn.date) %></b><% if (nextEarn.eps_estimated != null) { %> · verwachte winst per aandeel <b><%= fmt.price(nextEarn.eps_estimated) %></b><% } %><% if (nextEarn.revenue_estimated) { %> · omzet <b><%= fmt.money(nextEarn.revenue_estimated) %></b><% } %></p><% } %>
  <% if (earningsHist.length) { %>
  <%- charts.pairBars(earningsHist.map(function (h) { return { label: h.label, a: h.surprise, b: h.reaction, href: '/aandeel/' + encodeURIComponent(symbol) + '/cijfers/' + h.date }; }), { aLabel: 'Winstverrassing', bLabel: 'Koersreactie', height: 200 }) %>
  <% var lastE = earningsHist[earningsHist.length - 1]; %>
  <p class="small">Laatste cijfers (<%= fmt.date(lastE.date) %>): winst <span class="<%= fmt.tone(lastE.surprise) %>"><%= fmt.pct(lastE.surprise) %></span> t.o.v. verwachting, koers <span class="<%= fmt.tone(lastE.reaction) %>"><%= fmt.pct(lastE.reaction) %></span>, <span class="pos">▲<%= lastE.raises %></span> <span class="neg">▼<%= lastE.cuts %></span> koersdoelen. <a href="/aandeel/<%= encodeURIComponent(symbol) %>/cijfers/<%= lastE.date %>">Open de Earnings Reaction Monitor</a></p>
  <% } %>
</section>
<% } %>
<section class="card chart-card" id="tijdlijn">
  <div class="card-h"><h2>Koers en koersdoelen van <%= name %> door de tijd</h2><span class="small legend"><i class="cons"></i>Gemiddeld koersdoel</span></div>
  <%- timeline.svg %>
  <div class="tl-legend">
    <% timeline.legend.forEach(function (l) { %><label><input type="checkbox" checked data-firm="<%= l.key %>"><span class="dot" style="background:<%= l.color %>"></span><%= l.label %> <span class="muted">(<%= l.n %>)</span></label><% }) %>
  </div>
  <p class="small muted">Elke stip is een koersdoel. Zet banken aan of uit. Loopt de lijn van het gemiddelde koersdoel achter de koers aan, dan volgen analisten de markt eerder dan dat ze die voorspellen.</p>
  <script>
    document.querySelectorAll('#tijdlijn input[data-firm]').forEach(function (cb) {
      cb.addEventListener('change', function () {
        document.querySelectorAll('#tijdlijn .tl-dot.' + cb.dataset.firm).forEach(function (d) { d.style.display = cb.checked ? '' : 'none'; });
      });
    });
  </script>
</section>
<% } else if (history.length > 1) { %>
<section class="card chart-card">
  <div class="card-h"><h2>Koers afgelopen jaar</h2></div>
  <%- fmt.sparkline(history, { markers: consensus ? [ { value: consensus.targetLow, label: 'Laag', cls: 'lo' }, { value: consensus.targetConsensus, label: 'Gem.', cls: 'mid' }, { value: consensus.targetHigh, label: 'Hoog', cls: 'hi' } ] : [] }) %>
</section>
<% } %>

<% if (bull && bear) { var pr2 = quote && Number(quote.price); %>
<section class="card">
  <h2>Bulls versus bears</h2>
  <div class="battle">
    <% [['Grootste optimist', bull, 'pos'], ['Grootste pessimist', bear, 'neg']].forEach(function (b, bi) { var t = b[1]; var up = pr2 ? Number(t.price_target) / pr2 - 1 : null; %>
    <% if (bi === 1) { %><div class="battle-vs">VS</div><% } %>
    <div class="battle-side <%= b[2] %>">
      <span class="muted small"><%= b[0] %></span>
      <div class="id-row"><%- include('partials/score', { score: t.score }) %><div><% if (t.analyst_slug) { %><a class="strong" href="/analist/<%= t.analyst_slug %>"><%= t.analyst_name %></a><% } else { %><strong><%= t.analyst_name || t.analyst_firm %></strong><% } %><div class="muted small"><%= t.analyst_firm || '' %> · <%= fmt.date(t.published_at) %></div></div></div>
      <div class="battle-target"><strong><%= fmt.price(t.price_target) %></strong> <em class="<%= fmt.tone(up) %>"><%= fmt.pct(up) %></em></div>
    </div>
    <% }) %>
  </div>
</section>
<% } %>
<% if (sx.owners) { %><p class="sec-txt sec-lead"><%= sx.owners %></p><% } %>
<div class="grid2">
  <section class="card">
    <h2>Insider trades <%= name %></h2>
    <%- include('partials/insiders', { rows: insiders, hideSymbol: true }) %>
  </section>
  <section class="card">
    <h2>Wie kent <%= symbol %> het best?</h2>
    <% if (!experts.length) { %><p class="empty">Nog niet genoeg beoordeelde adviezen op dit aandeel.</p><% } else { %>
    <p class="small muted">Analisten gerangschikt op hun adviezen voor dít aandeel (minimaal 2).</p>
    <table class="tbl"><thead><tr><th>Score</th><th>Analist</th><th class="r">Adviezen</th><th class="r">Trefkans</th><th class="r">Vs. S&amp;P</th></tr></thead><tbody>
    <% experts.forEach(function (e) { %><tr><td><%- include('partials/score', { score: e.score }) %></td><td><a href="/analist/<%= e.slug %>" class="strong"><%= e.name %></a><div class="muted small"><%= e.firm %></div></td><td class="r"><%= e.calls %></td><td class="r"><%= fmt.pct(e.hit_rate, false) %></td><td class="r <%= fmt.tone(e.avg_excess) %>"><%= fmt.pct(e.avg_excess) %></td></tr><% }) %>
    </tbody></table><% } %>
  </section>
  <section class="card">
    <h2>Guru's met <%= name %> in portefeuille</h2>
    <% if (!holders.length) { %><p class="empty">Geen van de gevolgde fondsen heeft dit aandeel in de laatste 13F.</p><% } else { %>
    <table class="tbl"><thead><tr><th>Fonds</th><th class="r">Gewicht</th><th class="r">Waarde</th></tr></thead><tbody>
    <% holders.forEach(function (h) { %><tr><td><a href="/fonds/<%= h.slug %>" class="strong"><%= h.manager %></a> <span class="muted small"><%= h.name %></span></td><td class="r"><%= fmt.pct(h.weight, false) %></td><td class="r"><%= fmt.money(h.value) %></td></tr><% }) %>
    </tbody></table><% } %>
    <% if (profile && profile.description) { %><h2 class="mt">Over <%= profile.companyName %></h2><p class="small desc"><%= profile.description %></p><% } %>
  </section>
</div>
<%- include('partials/foot') %>
